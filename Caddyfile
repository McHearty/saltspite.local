}

# ------------------------------------------
# HOST-NETWORK SERVICES
# ------------------------------------------
# Replace <NAS_IP> with the static local IP address of your Synology NAS (e.g., 192.168.1.50)
# Caddy cannot use container hostnames for services running in host mode.

http://plex.saltspite.server {
    import internal-only
    reverse_proxy <NAS_IP>:32400
}

http://jellyfin.saltspite.server {
    import internal-only
    reverse_proxy <NAS_IP>:8096
}


